# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# --- Google Calendar ---
# From Google Cloud Console > APIs & Services > Credentials
# (OAuth client type: "Desktop app" works well for the refresh-token script below)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate this once by running: node scripts/get-google-refresh-token.mjs
GOOGLE_REFRESH_TOKEN=
# The calendar to check/write to. "primary" = the account's main calendar,
# or paste a specific calendar's ID (Calendar settings > Integrate calendar).
GOOGLE_CALENDAR_ID=primary

# --- Business hours / booking rules ---
# These SEED the database on first run only. After that, edit them at
# /admin/settings — changes there take effect immediately, no redeploy.
BUSINESS_TIMEZONE=America/Toronto
BUSINESS_OPEN_HOUR=8
BUSINESS_CLOSE_HOUR=18
SLOT_INCREMENT_MINUTES=30
# Earliest bookable day, in days from today.
#   0 = same-day booking allowed
#   1 = tomorrow at the earliest (default)
# Days inside this window show greyed-out as "Too soon to book".
BOOKING_LEAD_DAYS=1
# Days you're closed, 0=Sunday … 6=Saturday. Comma-separated.
# Default "0" (closed Sundays) matches the Mon–Sat hours on the site.
CLOSED_DAYS=0
# How many days ahead the booking calendar shows.
BOOKING_WINDOW_DAYS=21

# --- Admin dashboard (/admin) ---
# No password goes here any more. /admin uses real accounts: the first time
# you visit /login with an empty database you're asked to create the owner
# account, and the password is hashed (scrypt) and stored in data/store.json.
# Sessions are HTTP-only cookies. To reset a forgotten password, stop the
# server and delete the "users" array from data/store.json — the setup
# screen will come back.
